# Rust build output
/target
**/*.rs.bk
*.pdb

# Cargo
Cargo.lock.orig
.cargo/config.toml
.cargo/registry/

# Test and coverage artefacts
*.profraw
*.profdata
tarpaulin-report.html
lcov.info
/coverage/

